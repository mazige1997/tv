<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginLeft="@dimen/vs_60"
        android:layout_marginTop="@dimen/vs_20"
        android:layout_marginRight="@dimen/vs_60"
        android:layout_marginBottom="@dimen/vs_20"
        android:background="@drawable/shape_danmu_setting_bg"
        android:orientation="vertical"
        android:padding="@dimen/vs_20">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="诊断日志"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_28" />

        <TextView
            android:id="@+id/tvDiagInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:textColor="@color/dialog_text_hint"
            android:textSize="@dimen/ts_16" />

        <ScrollView
            android:id="@+id/svDiag"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/vs_10"
            android:layout_weight="1"
            android:background="@drawable/shape_setting_model_focus"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:padding="@dimen/vs_10"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tvDiagContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_16"
                android:typeface="monospace" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnDiagCopy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/vs_5"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_10"
                android:text="复制全部"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_20" />

            <TextView
                android:id="@+id/btnDiagShare"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_5"
                android:layout_marginRight="@dimen/vs_5"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_10"
                android:text="分享"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_20" />

            <TextView
                android:id="@+id/btnDiagRefresh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_5"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_10"
                android:text="刷新"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_20" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnDiagClear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/vs_5"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_10"
                android:text="清空"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_20" />

            <TextView
                android:id="@+id/btnDiagClose"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_5"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_10"
                android:text="关闭"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_20" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
